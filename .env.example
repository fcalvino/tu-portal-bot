TU_PORTAL_USER=your_user_here
TU_PORTAL_PASS=your_password_here
TU_PORTAL_APP_NAME=Tu Portal
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
RAILWAY_API_TOKEN=your_railway_api_token_here

# Multi-sesión (opcional): cada proceso de bot con su propio Chrome.
# Preferí pasarlos por CLI (--session / --cdp-port) o export en la terminal,
# no fijos en .env si vas a correr varios bots a la vez.
# SESSION_ID=traumato
# CDP_PORT=9223
# CDP_PROFILE=/tmp/tu-portal-cdp-traumato
